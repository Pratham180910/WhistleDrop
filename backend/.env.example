# WhistleDrop Backend Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env to source control!

# PostgreSQL / Supabase Database Connection URL
# Example Supabase format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example Local PostgreSQL format: postgresql://postgres:password@localhost:5432/whistledrop
DATABASE_URL=postgresql://username:password@localhost:5432/whistledrop

# JWT Configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
